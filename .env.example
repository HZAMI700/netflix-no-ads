# Playback resolver (Vercel serverless). Copy to .env — never commit real values.
# Public URL of the Node torrent-to-HTTP backend (required for torrent playback).
BACKEND_URL=http://localhost:4000
# Browser origins allowed to call /api/playback ("*" is fine: GET-only, no credentials).
PLAYBACK_CORS=*
# Upstream timeout for the backend call (ms). Keep under your Vercel maxDuration.
PLAYBACK_TIMEOUT_MS=45000
# Exact origins (comma-separated) allowed for ?direct= media URLs. Empty = none allowed.
ALLOWED_MEDIA_ORIGINS=
